# Copy to .env for local development and replace with real secrets if needed.
SECRET_KEY=change-me-in-development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# RL / forecasting
RL_BACKEND=q_learning
REWARD_SHAPING_ENABLED=true
REWARD_SENTIMENT_WEIGHT=0.15
REWARD_LLM_URL=
REWARD_LLM_TIMEOUT=1.5

# Stable simulation dynamics
TRANSITION_NOISE_SCALE=0.35
TRANSITION_RECOVERY_RATE=0.12
TRANSITION_TENSION_RELAXATION=0.30
TRANSITION_MAX_EFFECT=7.5
