# ============================================================
# Geo AI Strategic Nexus — Backend Environment
# ============================================================

# ---- Security ----
SECRET_KEY=change-me-in-development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- RL / Forecasting ----
RL_BACKEND=q_learning
REWARD_SHAPING_ENABLED=true
REWARD_SENTIMENT_WEIGHT=0.15
REWARD_LLM_URL=
REWARD_LLM_TIMEOUT=1.5

# ---- Stable simulation dynamics ----
TRANSITION_NOISE_SCALE=0.35
TRANSITION_RECOVERY_RATE=0.12
TRANSITION_TENSION_RELAXATION=0.30
TRANSITION_MAX_EFFECT=7.5

# ============================================================
# News ingestion (RSS-first, GDELT optional)
# ============================================================

# Master switch for GDELT.
#   true  = try GDELT in parallel (subject to fast timeout + circuit breaker)
#   false = skip GDELT entirely (recommended if GDELT is slow from your region)
ENABLE_GDELT=false

# Fast timeouts — an unreachable GDELT never blocks a request.
GDELT_TIMEOUT=6.0
GDELT_CONNECT_TIMEOUT=3.0
GDELT_MAX_RETRIES=1

# Circuit breaker: after N consecutive failures, skip GDELT for M seconds.
GDELT_CB_THRESHOLD=2
GDELT_CB_OPEN_SECONDS=600

# Hard wall-clock cap for one country fetch (RSS + WorldBank + GDELT combined).
NEWS_TOTAL_DEADLINE=15.0