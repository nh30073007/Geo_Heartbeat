# সব .env files ignore করো
.env
.env.*
*.env
.env.local
.env.*.local
.env.production
.env.development
.env.staging
.env.test

# কিন্তু .env.example COMMIT হবে (template হিসেবে)
!.env.example
!.env.example.*

