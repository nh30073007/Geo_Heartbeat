# নতুন .gitignore ফাইল তৈরি করুন
@"
# Python
__pycache__/
*.pyc
venv/
.env
*.db
*.sqlite3
*.log
*.pkl
*.dump

# Node.js / NPM - IMPORTANT!
node_modules/
frontend/node_modules/
package-lock.json
yarn.lock
.next/
out/
dist/
build/
.env.local
.env.*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# OS
Thumbs.db
desktop.ini
"@ | Out-File -FilePath .gitignore -Encoding UTF8